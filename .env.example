# Copie para .env:  cp .env.example .env
# Nunca versione o .env.

# Obrigatórios — gere valores aleatórios:
#   openssl rand -hex 32     (ou: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=troque-por-um-valor-aleatorio-de-64-caracteres
POSTGRES_PASSWORD=troque-esta-senha

# Endereço onde você abre o sistema (usado nos links do Telegram).
PUBLIC_URL=http://localhost:8000
PORT=8000
# 127.0.0.1 = só este computador. 0.0.0.0 = qualquer aparelho da sua rede.
BIND_ADDRESS=127.0.0.1

# Intervalo de verificação de fontes RSS e e-mail (minutos).
SOURCES_INTERVAL_MINUTES=60
LOG_LEVEL=INFO

# Chave de IA, Telegram e e-mail são configurados pela interface
# (ficam criptografados no banco) — não coloque aqui.
